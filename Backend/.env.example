# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example) — CHAPERÍA PRO
# ==============================================================================
PORT=3000
NODE_ENV=development

# 1. BASE DE DATOS POSTGRESQL (En VPS Docker usar DB_HOST=chaperia_db y DB_NAME=chaperia_prod_db)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=chaperia_local_db
DB_SYNCHRONIZE=true

# 2. SEGURIDAD JWT
JWT_SECRET=cambiar_por_clave_secreta_en_produccion
JWT_EXPIRES_IN=24h

# 3. OPTIMIZACIÓN DE IMÁGENES WEBP (SHARP)
UPLOAD_DIR=uploads
WEBP_MAX_WIDTH=1600
WEBP_QUALITY=80

# 4. PARÁMETROS GLOBALES DE NEGOCIO
DEFAULT_USD_TO_CLP=980
DEFAULT_PENALTY_PER_DAY_USD=20
DEFAULT_MONTHLY_FIXED_COSTS_USD=2400

